# Server Port
PORT=5000

# Database Connection (MongoDB)
# Option 1: MongoDB Atlas (Cloud - Recommended for remote/cloud hosting)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_db?retryWrites=true&w=majority
#
# Option 2: Local MongoDB (Requires MongoDB Community Server or Docker running locally)
# MONGO_URI=mongodb://localhost:27017/campus_db
#
# Note: If MONGO_URI is omitted or cannot be reached, the server automatically
# starts an embedded In-Memory MongoDB for local development and testing.
MONGO_URI=mongodb://localhost:27017/campus_db

# JWT Authentication
JWT_SECRET=my_super_secret_campus_key_2026
JWT_EXPIRE=30d
